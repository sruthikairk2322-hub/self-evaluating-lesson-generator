

LLM_PROVIDER=anthropic        # anthropic | openai | mock
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Use a different (ideally stronger) model for the judge than for the writer.
GENERATOR_MODEL=claude-sonnet-5-5
EVALUATOR_MODEL=claude-opus-5-5

MAX_RETRIES=2                 # 1 or 2. Loop always ends after 1 + MAX_RETRIES attempts.
EVOLVE_THRESHOLD=2            # a check must fail on the first try this many times before a guideline is written
